<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="codexremote"
        Arguments=""
        InstallLocation="C:\Program Files\MaimoryLab\Codex Remote">
    </Installer>
    <PackageInformation
        PackageName="Codex Remote"
        PackageDisplayName="Codex Remote"
        PublisherName="CN=MaimoryLab"
        PublisherDisplayName="MaimoryLab"
        Version="0.1.0.0"
        PackageDescription="Local Codex remote control">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.maimorylab.codexremote"
                Description="Local Codex remote control"
                DisplayName="Codex Remote"
                ExecutableName="codexremote"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Codex Remote</DisplayName>
            <PublisherDisplayName>MaimoryLab</PublisherDisplayName>
            <Description>Local Codex remote control</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="codexremote.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
